Katschema {
  Start = Value

  Value =
  	Schema
    | JSON
    
  JSON =
  	Collection
    | Primitive
    
  Collection =
    Object
    | Array
	| Tuple
    
  Primitive =
    String
    | Number
    | True
    | False
    | Null
    
  Schema =
    SchemaAtom ("|" SchemaAtom)*

  SchemaAtom =
    "(" Type ("," Clause)* ","? ")"

  Type =
    TypeSum
    | Ref
    | Collection

  TypeSum =
    TypeAtom "|" TypeAtom ("|" TypeAtom)*

  TypeAtom =
    Ref
    | Collection
    | SchemaAtom
    
  Clause =
    Keyvalue
    | Tag
    | Expr

  Tag =
    Ident &("," | ")")

  Keyvalue =
    Ident Assign JSON

  Assign =
    assign

  assign = "=" ~"="

  Expr =
    OrExpr

  OrExpr =
    AndExpr ("||" AndExpr)*

  AndExpr =
    EqualExpr ("&&" EqualExpr)*

  EqualExpr =
    OrderExpr (EqualOp OrderExpr)?

  EqualOp =
    "==" | "!=" | "~" | inOp

  inOp = "in" ~identPart

  OrderExpr =
    AddExpr (OrderOp AddExpr)*

  OrderOp =
    "<=" | ">=" | "<" | ">"

  AddExpr =
    MulExpr (AddOp MulExpr)*

  AddOp =
    "+" | "-"

  MulExpr =
    UnaryExpr (MulOp UnaryExpr)*

  MulOp =
    "*" | "/" | "%"

  UnaryExpr =
    UnaryOp UnaryExpr -- prefix
    | Primary -- primary

  UnaryOp =
    "!" | "+" | "-"

  Primary =
    Funcall
    | Ref
    | JSON
    | Group

  Group =
    "(" Expr ")"

  Funcall =
    Ref "(" Args? ")"

  Args =
    Expr ("," Expr)* ","?
  
  Ident = 
  	ident
    
  Ref
    = "." refPart ("." refPart)* -- path
    | ident ("." refPart)* -- name

  ident
    = ~keyword refPart

  refPart
    = identStart identPart*
    
  identStart
    = letter
    | "_"

  identPart
    = identStart
    | digit
    
  keyword
    = ("true" | "false" | "null" | "in") ~identPart
    
  Object =
    "{" "}" -- empty
    | "{" Pair ("," Pair)* ","? "}" -- nonEmpty

  Pair =
    String ":" Value

  Array =
    "[" Value ("," Value)* ","? "]" -- nonEmpty
    | "[" "]" -- empty

  Tuple =
    "#{" Value ("," Value)* ","? "}" -- nonEmpty
    | "#{" "}" -- empty
  
  String (String) =
    stringLiteral

  stringLiteral =
    "\"" doubleStringCharacter* "\""

  doubleStringCharacter (character) =
    ~("\"" | "\\" | "\u0000".."\u001f") any -- nonEscaped
    | "\\" escapeSequence -- escaped

  escapeSequence =
    "\"" -- doubleQuote
    | "\\" -- reverseSolidus
    | "/" -- solidus
    | "b" -- backspace
    | "f" -- formfeed
    | "n" -- newline
    | "r" -- carriageReturn
    | "t" -- horizontalTab
    | "u" fourHexDigits -- codePoint

  fourHexDigits = hexDigit hexDigit hexDigit hexDigit

  Number (Number) =
    numberLiteral

  numberLiteral =
    decimal exponent -- withExponent
    | decimal -- withoutExponent

  decimal =
    wholeNumber "." digit+ -- withFract
    | wholeNumber -- withoutFract

  wholeNumber =
    "-" unsignedWholeNumber -- negative
    | unsignedWholeNumber -- nonNegative

  unsignedWholeNumber =
    "0" -- zero
    | nonZeroDigit digit* -- nonZero

  nonZeroDigit = "1".."9"

  exponent =
    exponentMark ("+"|"-") digit+ -- signed
    | exponentMark digit+ -- unsigned

  exponentMark = "e" | "E"

  True = trueLiteral
  False = falseLiteral
  Null = nullLiteral

  trueLiteral = "true" ~identPart
  falseLiteral = "false" ~identPart
  nullLiteral = "null" ~identPart
  
  space += comment

  comment
    = lineComment
    | blockComment

  lineComment
    = "//" (~"\n" any)* ("\n" | end)

  blockComment
    = "/*" (~"*/" any)* "*/"
}
